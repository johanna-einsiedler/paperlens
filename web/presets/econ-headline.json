{
  "id":                "econ-headline",
  "title":             "Econ regressions",
  "tagline":           "Extract every regression from an empirical-economics paper, classify headlines, rate confidence per data block",
  "description":       "Empirical-economics regression extractor.  Walks every results table in the paper and emits one sample per table — with the table's full set of regression columns rendered side-by-side under four sub-tabs (Metadata, Specification, Estimates, Classification) plus a Paper metadata tab.  Built to mirror how empirical-economics tables are actually read.",
  "mode":              "extraction",
  "default_provider":  "openai",
  "default_model":     "gpt-4o",
  "task_description":  "Extract every regression reported in the paper's tables — coefficients, standard errors, controls, sample size, model type, and headline classification — grouped by source table.  Each sample is one results table; each column within a table is one regression.",
  "context":           "Empirical-economics workflow for primary studies that report regression results in tables (typical AEJ / AER / QJE format).  One sample per table; the table's columns become the columns of the rendered display.",
  "prompt_template_file": "econ-headline.template.md",
  "template_params": {
    "data_sources": [
      "regressions_metadata",
      "regressions_specification",
      "regressions_estimates",
      "regressions_classification",
      "paper_metadata"
    ]
  },
  "sub_views": [
    {
      "id":              "regmeta",
      "label":           "Metadata",
      "include_keys":    ["sample_id", "table", "table_caption", "page",
                          "n_regressions", "regressions_metadata"],
      "evidence_keys":   ["regressions_metadata", "table", "table_caption",
                          "page", "panel", "column", "column_label"],
      "confidence_keys": ["regressions_metadata"]
    },
    {
      "id":              "regspec",
      "label":           "Specification",
      "include_keys":    ["sample_id", "regressions_specification"],
      "evidence_keys":   ["regressions_specification", "model_type",
                          "sample_size", "standard_errors", "fixed_effects",
                          "continuous_controls", "sample_restrictions",
                          "weights", "treatment_definition",
                          "iv_instruments", "unit_of_observation",
                          "time_period", "outcome_construction"],
      "confidence_keys": ["regressions_specification"]
    },
    {
      "id":              "regestimates",
      "label":           "Estimates",
      "include_keys":    ["sample_id", "regressions_estimates"],
      "evidence_keys":   ["regressions_estimates", "estimates",
                          "dependent_var",
                          "non_displayed_coefficients_present",
                          "data_construction_steps"],
      "confidence_keys": ["regressions_estimates"]
    },
    {
      "id":              "regclass",
      "label":           "Classification",
      "include_keys":    ["sample_id", "regressions_classification"],
      "evidence_keys":   ["regressions_classification",
                          "is_treatment_effect", "non_treatment_category",
                          "is_robustness_check", "is_headline",
                          "headline_reasoning"],
      "confidence_keys": ["regressions_classification"]
    },
    {
      "id":              "papermeta",
      "label":           "Paper metadata",
      "include_keys":    ["sample_id", "paper_metadata"],
      "evidence_keys":   ["paper_metadata", "title", "doi", "authors",
                          "year", "study_design",
                          "identification_strategy", "data_type",
                          "data_origin", "proprietary_data",
                          "geographic_scope"],
      "confidence_keys": ["paper_metadata"]
    }
  ],
  "skip_to":           "setup",
  "accent_color":      "#2c5aa0"
}
